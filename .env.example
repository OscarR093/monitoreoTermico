# ===================================================
# Configuración del Servidor (Intranet / VPN)
# ===================================================
# Dirección IP del servidor + puerto para acceder a la app.
# Ejemplo: 192.168.1.100:8420
DOMAIN_URL=192.168.1.100:8420

# ===================================
# Configuración de MongoDB
# ===================================
MONGO_USER=your_mongo_user
MONGO_PASS=your_mongo_password
MONGO_DB_NAME=monitoreoTermico

# ===================================
# Configuración de EMQX (Broker MQTT)
# ===================================
MOSQUITTO_USER=your_mqtt_user
MOSQUITTO_PASS=your_mqtt_password
EMQX_NODE_COOKIE=a_very_long_and_secret_cookie_for_emqx

# ===================================
# Secretos de la Aplicación Node.js
# ===================================
JWT_SECRET=a_very_long_and_secure_jwt_secret
NODE_ENV=production

# ===================================
# Configuración de Super Usuario
# ===================================
SUPER_USER_USERNAME=superuser_example
SUPER_USER_PASSWORD=superpassword_example

# ===================================
# Alertas por Telegram (opcional)
# ===================================
# Si la intranet no tiene acceso a internet, dejar vacío para deshabilitar.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_name
